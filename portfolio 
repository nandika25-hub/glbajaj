<section id="contact">
    <h2 class="heading">Let's Connect</h2>
    <div class="contact-card">
        <p>Have an opportunity or idea? I'd love to connect!</p>
        <p>
            GitHub:
            <a href="https://github.com/nandika25-hub"
               target="_blank" rel="noopener noreferrer">
                github.com/nandika25-hub
            </a>
        </p>
        <p>Email: Add your email address here</p>
        <p>LinkedIn: Add your LinkedIn profile here</p>
    </div>
</section>

<footer>
    <p>© <span id="year"></span> Nandika Mishra · Made with ♥</p>
</footer>

<script>
document.getElementById("year").textContent =
    new Date().getFullYear();

document.querySelectorAll('nav a').forEach(function(link) {
    link.addEventListener('click', function() {
        console.log("Section selected:", link.textContent);
    });
});
</script>

</body>
</html>
