
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nandika Mishra | Portfolio</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #111318;
    color: #f5f5f5;
    line-height: 1.7;
}

header {
    padding: 18px 8%;
    background: #191c23;
    position: sticky;
    top: 0;
    z-index: 10;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.logo {
    font-size: 26px;
}

.logo span, .highlight {
    color: #f4c542;
}

nav ul {
    display: flex;
    gap: 20px;
    list-style: none;
    flex-wrap: wrap;
}

nav a {
    text-decoration: none;
    color: white;
    transition: 0.3s;
}

nav a:hover {
    color: #f4c542;
}

.hero {
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 70px 10%;
    background: radial-gradient(circle at top right, #30313a, #111318 60%);
}

.hero-content {
    max-width: 750px;
}

.tag {
    color: #f4c542;
    letter-spacing: 2px;
    font-size: 13px;
}

h1 {
    font-size: clamp(38px, 6vw, 60px);
    line-height: 1.2;
    margin: 20px 0;
}

.hero h2 {
    color: #c6c7ce;
    margin-bottom: 15px;
}

p {
    color: #c6c7ce;
}

.hero p {
    max-width: 620px;
    margin-bottom: 28px;
}

.btn {
    display: inline-block;
    padding: 12px 24px;
    background: #f4c542;
    color: #111318;
    text-decoration: none;
    font-weight: bold;
    border-radius: 7px;
    transition: 0.3s;
}

.btn:hover {
    background: white;
    transform: translateY(-3px);
}

section:not(.hero) {
    padding: 75px 10%;
}

.heading {
    font-size: 32px;
    text-align: center;
    margin-bottom: 35px;
}

.heading::after {
    content: "";
    display: block;
    width: 55px;
    height: 4px;
    background: #f4c542;
    margin: 10px auto;
    border-radius: 5px;
}

.about-card, .contact-card {
    max-width: 800px;
    margin: auto;
    padding: 30px;
    background: #1b1e26;
    border: 1px solid #30333d;
    border-radius: 12px;
    text-align: center;
}

.skills, .projects {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
}

.skill {
    background: #1b1e26;
    color: #f4c542;
    border: 1px solid #f4c542;
    border-radius: 8px;
    padding: 12px 23px;
    transition: 0.3s;
}

.skill:hover {
    background: #f4c542;
    color: #111318;
    transform: translateY(-4px);
}

.project {
    flex: 1 1 230px;
    max-width: 350px;
    padding: 25px;
    background: #1b1e26;
    border: 1px solid #30333d;
    border-radius: 12px;
    transition: 0.3s;
}

.project:hover {
    transform: translateY(-6px);
    border-color: #f4c542;
}

.project h3 {
    color: #f4c542;
    margin-bottom: 12px;
}

.project p {
    margin-bottom: 15px;
}

.project small {
    color: #a5a7b1;
}

.contact-card p {
    margin: 10px 0;
    overflow-wrap: anywhere;
}

.contact-card a {
    color: #f4c542;
    text-decoration: none;
}

footer {
    background: #191c23;
    text-align: center;
    padding: 22px;
}

footer p {
    font-size: 14px;
}

@media (max-width: 600px) {
    header {
        padding: 16px 5%;
    }

    nav {
        justify-content: center;
    }

    nav ul {
        justify-content: center;
        gap: 12px;
    }

    .hero {
        padding: 65px 7%;
        min-height: 75vh;
    }

    section:not(.hero) {
        padding: 55px 7%;
    }

    .heading {
        font-size: 27px;
    }
}
</style>
</head>

<body>

<header>
    <nav>
        <h2 class="logo">Nandika<span>.</span></h2>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#projects">Projects</a></li>
